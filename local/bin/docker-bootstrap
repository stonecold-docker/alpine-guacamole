#!/bin/sh

set -e

if [ -e /.init ]; then
	exit
fi

touch /.init

mkdir -p /conf.d /conf.d/postgresql

if [ ! -e /conf.d/guacamole/guacamole.properties -o ! -e /app/guacamole/guacamole.properties ]; then
	mkdir -p /conf.d/guacamole
	cat << EOF > /conf.d/guacamole/guacamole.properties
# Hostname and port of guacamole proxy
guacd-hostname: localhost
guacd-port:     4822

# Auth provider class
#auth-provider: org.glyptodon.guacamole.auth.postgresql.PostgreSQLAuthenticationProvider

# postgresql properties
postgresql-hostname: localhost
postgresql-port: 5432
postgresql-database: guacamole_db
postgresql-username: guacamole_user
postgresql-password: some_password
EOF
	ln -sf /conf.d/guacamole/guacamole.properties /app/guacamole/guacamole.properties
fi

chown -R postgres:postgres /conf.d/postgresql
if [ ! -e /conf.d/postgresql/base ]; then
	rm -rf /conf.d/postgresql/*

	cat << 'EOF' > /usr/local/bin/locale
#!/bin/sh
echo > /dev/null
EOF
	chmod 755 /usr/local/bin/locale
	su-exec postgres pg_ctl initdb -D /conf.d/postgresql
	rm -rf /usr/local/bin/locale
	su-exec postgres pg_ctl start -D /conf.d/postgresql
	su-exec postgres createdb guacamole_db
	for sql in /app/guacamole/schema/*.sql
	do
		su-exec postgres psql -d guacamole_db -f ${sql}
	done
	su-exec postgres pg_ctl stop -D /conf.d/postgresql
fi

