#!/bin/sh

set -e

if [ -z "$(grep 'https://mirror.xtom.com.hk/alpine/v3.14/main/' /etc/apk/repositories)" ]; then
	echo "https://mirror.xtom.com.hk/alpine/v3.14/main" >> /etc/apk/repositories
fi

if [ "$(uname -m)" = "aarch64" -a -z "$(grep 'https://mirror.xtom.com.hk/alpine/v3.17/community/' /etc/apk/repositories)" ]; then
	echo "https://mirror.xtom.com.hk/alpine/v3.17/community" >> /etc/apk/repositories
fi

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="goreman su-exec guacamole-server guacamole-server-dev openjdk8-jre-base jetty-runner postgresql java-postgresql-jdbc ttf-dejavu"
PKG_DEV="p7zip"
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
mkdir -p /run/postgresql
chown postgres:postgres /run/postgresql
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting build environment"
GUACAMOLE_VERSION="$(wget --no-check-certificate -q -O - https://guacamole.apache.org/releases/ | grep '/releases/[0-9]' | head -1 | sed -e 's/^.*<a href="[^>]*">\([^<]*\)<\/a>.*$/\1/g')"
GUACAMOLE_URL="https://mirror.navercorp.com/apache/guacamole/${GUACAMOLE_VERSION}/binary/guacamole-${GUACAMOLE_VERSION}.war"
GUACAMOLE_AUTH_URL="https://mirror.navercorp.com/apache/guacamole/${GUACAMOLE_VERSION}/binary/guacamole-auth-jdbc-${GUACAMOLE_VERSION}.tar.gz"
echo "GUACAMOLE_VERSION  : ${GUACAMOLE_VERSION}"
echo "GUACAMOLE_URL      : ${GUACAMOLE_URL}"
echo "GUACAMOLE_AUTH_URL : ${GUACAMOLE_AUTH_URL}"
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing guacamole"
mkdir -p /app/guacamole /app/guacamole/extensions /app/guacamole/lib
cd /app/guacamole
wget --no-check-certificate -q -O guacamole-${GUACAMOLE_VERSION}.war "${GUACAMOLE_URL}"
wget --no-check-certificate -q -O - "${GUACAMOLE_AUTH_URL}" | tar zx
mv /app/guacamole/guacamole-auth-jdbc-*/postgresql/guacamole-auth-jdbc-postgresql-*.jar /app/guacamole/extensions/
mv /app/guacamole/guacamole-auth-jdbc-*/postgresql/schema /app/guacamole/
rm -rf /app/guacamole/guacamole-auth-jdbc-*
ln -sf /usr/share/java/postgresql-jdbc.jar /app/guacamole/lib/
cat << EOF > /app/guacamole/schema/003-create-db-user.sql
CREATE USER guacamole_user WITH PASSWORD 'some_password';
GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO guacamole_user;
GRANT SELECT,USAGE ON ALL SEQUENCES IN SCHEMA public TO guacamole_user;
EOF
cat << EOF > /app/guacamole/guacamole.properties
# Hostname and port of guacamole proxy
guacd-hostname: localhost
guacd-port:     4822

# Auth provider class
auth-provider: org.glyptodon.guacamole.auth.postgresql.PostgreSQLAuthenticationProvider

# postgresql properties
postgresql-hostname: localhost
postgresql-port: 5432
postgresql-database: guacamole_db
postgresql-username: guacamole_user
postgresql-password: some_password
EOF
cat << EOF > /app/guacamole/logback.xml
<configuration>

    <!-- Appender for debugging -->
    <appender name="GUAC-INFO" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Log at INFO level -->
    <root level="info">
        <appender-ref ref="GUAC-INFO"/>
    </root>

</configuration>
EOF
chown -R root:root /app/guacamole
cat << EOF > /etc/profile.d/guacamole.sh
export GUACAMOLE_HOME=/app/guacamole
EOF
chmod 755 /etc/profile.d/guacamole.sh
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing fonts"
mkdir -p /build/fonts
cd /build/fonts
wget --no-check-certificate -q -O BitstreamVeraSansMono.ttf http://cfile8.uf.tistory.com/attach/115363354F386D452327BB
wget --no-check-certificate -q -O NanumFontSetup_TTF_GOTHIC_hangeulcamp.exe http://cdn.naver.com/naver/NanumFont/setup/NanumFontSetup_TTF_GOTHIC_hangeulcamp.exe
wget --no-check-certificate -q -O NanumFontSetup_TTF_MYUNGJO_hangeulcamp.exe http://cdn.naver.com/naver/NanumFont/setup/NanumFontSetup_TTF_MYUNGJO_hangeulcamp.exe
nanumgothiccoding_version="$(wget --no-check-certificate -q -O - https://api.github.com/repos/naver/nanumfont/releases | grep '^    "name":' | grep -v 'beta' | head -1 | sed -e 's/^.*"name": "NanumGothicCoding \(.*\)".*$/\1/g')"
wget --no-check-certificate -q -O NanumGothicCoding.zip https://github.com/naver/nanumfont/releases/download/VER${nanumgothiccoding_version}/NanumGothicCoding-${nanumgothiccoding_version}.zip
7z x -y NanumFontSetup_TTF_GOTHIC_hangeulcamp.exe "\$WINDIR/Fonts" > /dev/null
7z x -y NanumFontSetup_TTF_MYUNGJO_hangeulcamp.exe "\$WINDIR/Fonts" > /dev/null
7z x -y NanumGothicCoding.zip "*.ttf" > /dev/null
mkdir -p "/usr/share/fonts/TTF"
cp "\$WINDIR/Fonts/"*.ttf /usr/share/fonts/TTF/
cp *.ttf /usr/share/fonts/TTF/
mkdir -p /etc/fonts/conf.d/
ln -s /usr/local/etc/10-antialias.conf /etc/fonts/conf.d/
ln -s /usr/local/etc/10-hinting.conf /etc/fonts/conf.d/
ln -s /usr/local/etc/30-cjk-aliases.conf /etc/fonts/conf.d/
ln -s /usr/local/etc/90-fonts-nanum.conf /etc/fonts/conf.d/
ln -s /usr/local/etc/90-fonts-nanum-coding.conf /etc/fonts/conf.d/
fc-cache -f -s > /dev/null
mkfontscale /usr/share/fonts/TTF
mkfontdir /usr/share/fonts/TTF
cd /
rm -rf /build
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting basic configurations"
mkdir -p /conf.d /conf.d/postgresql
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

